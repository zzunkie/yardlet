{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yardlet-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "FEEDBACK", "class_name": "FeedbackSubmission" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Account"] },
    { "tag": "v3", "new_sqlite_classes": ["FeedbackSubmission"] }
  ],
  // Feedback mail (README, "Feedback"). No destination here: the recipient is the FEEDBACK_TO secret, which must
  // be a verified destination address of the account's Email Routing.
  "send_email": [{ "name": "FEEDBACK_MAIL" }],
  // Feedback submissions per client address, and for everyone together. The limiter keeps its counters in
  // memory at each Cloudflare location and stores no key.
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "FEEDBACK_GLOBAL_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Anonymous counts (README, "What is counted"), shared with the edge Worker (edge/).
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "yardlet_metrics" }]
  // Secrets (`wrangler secret put`): FCM_SERVICE_ACCOUNT, FCM_PROJECT_ID, APNS_KEY, APNS_KEY_ID,
  // APNS_TEAM_ID, APNS_TOPIC, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // AUTH_STATE_SECRET, FEEDBACK_FROM, FEEDBACK_TO.
  // PUBLIC_URL, the relay's https base (e.g. "https://relay.example.test"): a secret too, so the deployed
  // address stays out of git; a later `wrangler deploy` keeps it.
}
