// The edge Worker (README, "Edge Worker"): Sparkle's appcasts on yardlet.app, passed on to the site unchanged and
// counted by version, and the download address, which redirects to the release's disk image. Deployed on its own,
// from this folder, after the relay; it shares the relay's counts dataset.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yardlet-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // The two appcast routes take effect only while yardlet.app's DNS record is proxied through Cloudflare; the
  // download host is a Custom Domain, which makes its own record.
  "routes": [
    { "pattern": "yardlet.app/appcast.xml", "zone_name": "yardlet.app" },
    { "pattern": "yardlet.app/appcast-x86_64.xml", "zone_name": "yardlet.app" },
    { "pattern": "dl.yardlet.app", "custom_domain": true }
  ],
  "vars": {
    "FEED_ORIGIN": "https://yardlet.app",
    "RELEASES": "https://github.com/zzunkie/yardlet/releases/download"
  },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "yardlet_metrics" }]
}
