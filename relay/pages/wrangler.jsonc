// The relay's second address, https://yardlet-relay-pages.pages.dev. Cloudflare serves *.pages.dev from the
// location nearest the client on networks that reach a free-plan zone such as relay.yardlet.app through a
// far one, so a client races this address against the main one (docs/REMOTE_PROTOCOL.md, "Relay").
// Everything is handed to the relay Worker unchanged, so both addresses reach the same rooms. JSONC, like the
// Worker's own configuration one folder up, so Wrangler finds this file first when run from here.
{
  "name": "yardlet-relay-pages",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-10-19",
  "services": [{ "binding": "RELAY", "service": "yardlet-relay" }]
}
