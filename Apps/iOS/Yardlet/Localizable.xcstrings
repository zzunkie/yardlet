    },
    "%@ offers no settings for this task now.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 %@에서 이 작업에 바꿀 설정이 없습니다."
          }
        }
      }
    },
    "%@ removed this phone. Pair it again to connect.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 휴대폰을 지웠습니다. 다시 연결하려면 새로 짝지으세요."
          }
        }
      }
    },
    "%@: %lld%% used": {
