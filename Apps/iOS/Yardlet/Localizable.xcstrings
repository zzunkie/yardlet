    "%lld tasks are currently running on %@. Checking and updating %@ now may affect active work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tasks are currently running on %@. Checking and updating %@ now may affect active work."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 %2$@에서 작업 %1$lld개가 실행 중입니다. 지금 %3$@ 업데이트를 확인하고 적용하면 실행 중인 작업에 영향을 줄 수 있습니다."
          }
        }
      }
    },
    "%lld tasks are currently running on %@. Updating %@ to %@ may affect active work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tasks are currently running on %@. Updating %@ to %@ may affect active work."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 %2$@에서 작업 %1$lld개가 실행 중입니다. %3$@을(를) %4$@ 버전으로 업데이트하면 실행 중인 작업에 영향을 줄 수 있습니다."
          }
        }
      }
    },
    "%lld tools": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tools"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 %lld개"
          }
        }
      }
    },
    "+%lld": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld"
          }
        }
      }
    },
    "30-day tokens": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30-day tokens"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 토큰"
          }
        }
      }
    },
    "A message of this task is being edited on %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 작업의 메시지를 고치는 중입니다."
          }
        }
      }
    },
    "A new device": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기기"
          }
        }
      }
    },
    "A new device wants to connect": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기기가 연결하려 합니다"
          }
        }
      }
    },
    "A run of it is already starting.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 실행을 시작하는 중입니다."
          }
        }
      }
    },
    "A window or dialog over this page waits on %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지 위의 창이나 대화상자가 %@에서 답을 기다립니다."
          }
        }
      }
    },
    "Access Token (optional)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access Token (optional)"
