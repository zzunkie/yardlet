          }
        }
      }
    },
    "To pair a Mac, open Yardlet › Settings… › Remote on it and choose Pair… beside Pair a device. Swipe a Mac to remove it; it forgets this phone too.": {
      "localizations": {
        "ko": {
          "stringUnit": {
