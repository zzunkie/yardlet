      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld"
          }
        }
      }
    },
    "A message of this task is being edited on %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 작업의 메시지를 고치는 중입니다."
          }
        }
      }
    },
    "A new device": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기기"
          }
        }
      }
    },
    "A new device wants to connect": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기기가 연결하려 합니다"
          }
        }
      }
    },
    "A run of it is already starting.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 실행을 시작하는 중입니다."
          }
        }
      }
    },
    "A window or dialog over this page waits on %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지 위의 창이나 대화상자가 %@에서 답을 기다립니다."
          }
        }
      }
    },
    "Add Photos": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 추가"
          }
        }
      }
    },
    "After This Turn (Queue)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 턴이 끝난 뒤(대기열)"
          }
        }
      }
    },
    "Agent": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용"
          }
        }
      }
    },
    "Allow Once": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 허용"
          }
        }
      }
    },
    "Allow camera access in Settings, or paste the pairing link instead.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 카메라 접근을 허용하거나, 연결 링크를 붙여 넣으세요."
          }
        }
      }
    },
    "Allow for This Session": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션 동안 허용"
          }
        }
      }
    },
    "Allow it only if %@ shows the same number. Refuse a device you don't know.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에도 같은 숫자가 보이면 허용하세요. 모르는 기기면 거절하세요."
          }
        }
      }
    },
    "Allowed: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용함: %@"
          }
        }
      }
    },
    "Allowing it uses %@'s %@, not this phone's.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 이 휴대폰이 아니라 %1$@의 %2$@를 씁니다."
          }
        }
      }
    },
    "Another app is using this task's conversation.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 이 작업의 대화를 쓰고 있습니다."
          }
        }
      }
    },
    "Answer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변"
          }
        }
      }
    },
    "Answered: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답함: %@"
          }
        }
      }
    },
    "App Lock": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 잠금"
          }
        }
      }
    },
    "Approaching your session limit": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 한도에 가까워졌습니다"
          }
        }
      }
    },
    "Approaching your usage limit": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 한도에 가까워졌습니다"
          }
        }
      }
    },
    "Approaching your weekly limit": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 한도에 가까워졌습니다"
          }
        }
      }
    },
    "Approval requested": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 요청"
          }
        }
      }
    },
    "Approvals, questions and finished tasks, sent by your Mac while Yardlet is closed. Their content is encrypted for this phone; Apple and the relay can't read it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardlet이 닫혀 있는 동안 Mac이 승인 요청, 질문, 끝난 작업을 알립니다. 내용은 이 휴대폰만 열 수 있게 암호화되어 Apple과 중계 서버는 읽지 못합니다."
          }
        }
      }
    },
    "Approve Plan": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획 승인"
          }
        }
      }
    },
    "Archive": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관"
          }
        }
      }
    },
    "Archive this task?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 보관할까요?"
          }
        }
      }
    },
    "Asks for Face ID or your passcode each time you open Yardlet.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardlet을 열 때마다 Face ID나 암호를 묻습니다."
