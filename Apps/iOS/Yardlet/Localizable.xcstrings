{
  "sourceLanguage": "en",
  "strings": {
    "%@ couldn't do that.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 그 작업을 하지 못했습니다."
          }
        }
      }
    },
    "%@ doesn't offer that choice now. Pick again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 지금 그 선택지를 쓸 수 없습니다. 다시 고르세요."
          }
        }
      }
    },
    "%@ is changing this task. Try again in a moment.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 작업을 바꾸는 중입니다. 잠시 뒤 다시 시도하세요."
          }
        }
      }
    },
    "%@ no longer lists it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 작업이 더 이상 없습니다."
          }
        }
      }
    },
    "%@ no longer lists this task.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 작업이 더 이상 없습니다."
