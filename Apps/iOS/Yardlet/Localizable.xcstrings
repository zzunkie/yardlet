          "stringUnit": {
            "state": "translated",
            "value": "사진 추가"
          }
        }
      }
    },
    "Added to tasks started or resumed on %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added to tasks started or resumed on %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 시작하거나 재개하는 작업에 포함됩니다."
          }
        }
      }
    },
    "After This Turn (Queue)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 턴이 끝난 뒤(대기열)"
          }
        }
      }
    },
    "Agent": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용"
          }
        }
      }
    },
    "Allow %@'s display to sleep normally while tasks run?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow %@'s display to sleep normally while tasks run?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중에도 %@의 디스플레이가 정상적으로 잠들도록 허용할까요?"
          }
        }
      }
    },
    "Allow Change settings for this device on %@ to change accounts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Change settings for this device on %@ to change accounts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 기기의 설정 변경 권한을 허용해야 계정을 변경할 수 있습니다."
          }
        }
      }
    },
    "Allow Change settings for this device on %@ to change connectors.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Change settings for this device on %@ to change connectors."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 기기의 설정 변경 권한을 허용해야 커넥터를 변경할 수 있습니다."
          }
        }
      }
    },
    "Allow Change settings for this device on %@ to edit instructions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Change settings for this device on %@ to edit instructions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 기기의 설정 변경 권한을 허용해야 지침을 편집할 수 있습니다."
          }
        }
      }
    },
    "Allow Change settings for this device on %@ to edit settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Change settings for this device on %@ to edit settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 기기의 설정 변경 권한을 허용해야 설정을 바꿀 수 있습니다."
          }
        }
      }
    },
    "Allow Change settings for this device on %@ to update CLIs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Change settings for this device on %@ to update CLIs."
          }
        },
        "ko": {
