{
  "sourceLanguage": "en",
  "strings": {
    "%@ %lld%%": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld%%"
          }
        }
      }
    },
    "%@ %lld%% · resets %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld%% · %3$@ 초기화"
          }
        }
      }
    },
    "%@ asks for a passkey": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 패스키를 요청합니다"
          }
        }
      }
    },
    "%@ asks for a permission": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 권한을 요청합니다"
          }
        }
      }
    },
    "%@ asks to open another app": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 다른 앱을 열려고 합니다"
          }
        }
      }
    },
    "%@ asks you to sign in": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 로그인을 요청합니다"
          }
        }
      }
    },
    "%@ can't move this task to that account now.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 지금 이 작업을 그 계정으로 옮길 수 없습니다."
          }
        }
      }
    },
    "%@ can't open its browser right now.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 지금 브라우저를 열 수 없습니다."
          }
        }
      }
    },
    "%@ can't use this harness now.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 지금 이 하네스를 쓸 수 없습니다."
          }
        }
      }
    },
    "%@ couldn't do that.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 그 작업을 하지 못했습니다."
          }
        }
      }
    },
    "%@ doesn't offer that choice now. Pick again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 지금 그 선택지를 쓸 수 없습니다. 다시 고르세요."
          }
        }
      }
    },
    "%@ doesn't take these photos.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 이 사진을 받지 않습니다."
          }
        }
      }
    },
    "%@ doesn't take this %@ choice now. Pick again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 지금 이 %2$@ 선택지를 받지 않습니다. 다시 고르세요."
          }
        }
      }
    },
    "%@ doesn't take this setting now.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 지금 이 설정을 받지 않습니다."
          }
        }
      }
    },
    "%@ is changing this task. Try again in a moment.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 작업을 바꾸는 중입니다. 잠시 뒤 다시 시도하세요."
          }
        }
      }
    },
    "%@ is waiting for an answer to its dialog": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 대화상자가 답을 기다립니다"
          }
        }
      }
    },
    "%@ is waiting for you": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 답을 기다립니다"
          }
        }
      }
    },
    "%@ is waiting for you to choose a file": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 파일 선택을 기다립니다"
          }
        }
      }
    },
    "%@ no longer has this scheduled task.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 예약된 작업이 없습니다."
          }
        }
      }
    },
    "%@ no longer has this subagent.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 하위 에이전트를 더 이상 찾을 수 없습니다."
          }
        }
      }
    },
    "%@ no longer lists it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 작업이 더 이상 없습니다."
          }
        }
      }
    },
    "%@ no longer lists this task.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 작업이 더 이상 없습니다."
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ offers no settings for this task now.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 %@에서 이 작업에 바꿀 설정이 없습니다."
          }
        }
      }
    },
    "%@ removed this phone. Pair it again to connect.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 휴대폰을 지웠습니다. 다시 연결하려면 새로 짝지으세요."
          }
        }
      }
    },
    "%@. Answer it on %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@에서 답하세요."
          }
        }
      }
    },
