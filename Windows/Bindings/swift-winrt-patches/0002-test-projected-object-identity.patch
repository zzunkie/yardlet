     }
+
+    bool StaticClass::IsSameObject(Windows::Foundation::IInspectable const& first, Windows::Foundation::IInspectable const& second)
+    {
+        // C++/WinRT compares the objects' IUnknown, as COM identity is defined.
+        return first == second;
+    }
 }
